# This .gitignore file should be placed at the root of your Unity project directory
#
# Get latest from https://github.com/github/gitignore/blob/main/Unity.gitignore
#
BasePlataformas2D/[Ll]ibrary/
BasePlataformas2D/[Tt]emp/
BasePlataformas2D/[Oo]bj/
BasePlataformas2D/[Bb]uild/
BasePlataformas2D/[Bb]uilds/
BasePlataformas2D/[Ll]ogs/
BasePlataformas2D/[Uu]ser[Ss]ettings/

# MemoryCaptures can get excessive in size.
# They also could contain extremely sensitive data
BasePlataformas2D/[Mm]emoryCaptures/

# Recordings can get excessive in size
BasePlataformas2D/[Rr]ecordings/

# Uncomment this line if you wish to ignore the asset store tools plugin
# /[Aa]ssets/AssetStoreTools*

# Autogenerated Jetbrains Rider plugin
BasePlataformas2D/[Aa]ssets/Plugins/Editor/JetBrains*

# Visual Studio cache directory
BasePlataformas2D/.vs/

# Gradle cache directory
BasePlataformas2D/.gradle/

# Autogenerated VS/MD/Consulo solution and project files
ExportedObj/
BasePlataformas2D/.consulo/
BasePlataformas2D/*.csproj
BasePlataformas2D/*.unityproj
BasePlataformas2D/*.sln
BasePlataformas2D/*.suo
BasePlataformas2D/*.tmp
BasePlataformas2D/*.user
BasePlataformas2D/*.userprefs
BasePlataformas2D/*.pidb
BasePlataformas2D/*.booproj
BasePlataformas2D/*.svd
BasePlataformas2D/*.pdb
BasePlataformas2D/*.mdb
BasePlataformas2D/*.opendb
BasePlataformas2D/*.VC.db

# Unity3D generated meta files
BasePlataformas2D/*.pidb.meta
BasePlataformas2D/*.pdb.meta
BasePlataformas2D/*.mdb.meta

# Unity3D generated file on crash reports
BasePlataformas2D/sysinfo.txt

# Builds
BasePlataformas2D/*.apk
BasePlataformas2D/*.aab
BasePlataformas2D/*.unitypackage
BasePlataformas2D/*.unitypackage.meta
BasePlataformas2D/*.app

# Crashlytics generated file
BasePlataformas2D/crashlytics-build.properties

# Packed Addressables
BasePlataformas2D/[Aa]ssets/[Aa]ddressable[Aa]ssets[Dd]ata/*/*.bin*

# Temporary auto-generated Android Assets
BasePlataformas2D/[Aa]ssets/[Ss]treamingAssets/aa.meta
BasePlataformas2D/[Aa]ssets/[Ss]treamingAssets/aa/*
